OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=3000
# Comma-separated browser origins allowed to call /api. A different Origin is rejected.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional. Public ElevenLabs conversational agent id. When set, the concierge page
# loads the voice widget. No API key belongs in the browser. The agent only works on
# domains in its ElevenLabs allowlist (the owner adds the demo host there).
# ELEVENLABS_AGENT_ID=agent_9201m73bzadmf0yr6mxa4q8s98n0
# Optional filesystem path for the leads database. Defaults to ./concierge.sqlite.
# DATABASE_PATH=
